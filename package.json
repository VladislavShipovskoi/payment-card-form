{
  "name": "payment-card-form",
  "version": "0.1.0",
  "description": "Accessible card form playground built with TypeScript and vanilla-extract",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
